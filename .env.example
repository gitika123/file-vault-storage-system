APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://balkanid:balkanid@localhost:5432/balkanid?sslmode=disable
POSTGRES_PASSWORD=replace-with-local-postgres-password
SEED_ALICE_PASSWORD=replace-with-at-least-12-characters
SEED_BOB_PASSWORD=replace-with-at-least-12-characters
SEED_ADMIN_PASSWORD=AdminVault!2026
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SECURE=false
API_RATE_PER_SECOND=2
API_RATE_BURST=4
USER_QUOTA_BYTES=10485760
MAX_FILE_BYTES=10485760
MAX_UPLOAD_BYTES=52428800
BLOB_STORE_DRIVER=local
BLOB_STORE_PATH=./data/blobs
PUBLIC_SHARE_BASE_URL=http://localhost:5173/share
LOG_LEVEL=info
